# Copy outside your source checkout or to an ignored .env.
PUBLIC_URL=https://agent.example.com
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
# Stable OIDC subject IDs, not display names. Comma separated; empty denies all.
ALLOWED_SUBJECTS=CHANGE_ME
LISTEN_HOST=127.0.0.1
# Optional private host/guest split: see docs/private-proxy.md.
# TRUSTED_PROXY_IP=PROXY_PRIVATE_IPV4
LISTEN_PORT=4180
DATABASE_PATH=/var/lib/harness-gateway/sessions.sqlite
HARNESS_UPSTREAM=http://127.0.0.1:3080
HARNESS_LAUNCH_URL_FILE=/run/harness-gateway/launch-url
SESSION_MAX_DAYS=90
SESSION_IDLE_DAYS=7
MAX_UPLOAD_MIB=128
