{
  "module": {
    "name": "entry",
    "type": "entry",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "icon": "$media:app_layered_image",
        "label": "$string:app_name",
        "exported": true,
        "backgroundModes": ["dataTransfer"],
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ],
        "launchType": "singleton"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.ACCESS_FIDO2_ONLINEAUTH"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:background_monitor_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      }
    ],
    "metadata": [
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "default"
      }
    ],
    "extensionAbilities": [
      {
        "name": "PocketFormAbility",
        "srcEntry": "./ets/entryformability/PocketFormAbility.ets",
        "type": "form",
        "exported": true,
        "label": "$string:widget_quick_name",
        "description": "$string:widget_description",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ]
  }
}
