# These are documentation placeholders. Never commit your actual .env.
PUBLIC_ORIGIN=https://dsh.example.com
UPSTREAM=http://127.0.0.1:3000
# One-time URL printed by `dsh web`; keep it server-side. Refresh after restarting Harness.
UPSTREAM_LAUNCH_URL=
# Alternatively supply a previously exchanged Harness cookie. Do not put both.
UPSTREAM_COOKIE=
AUTH_MODE=passkey
ALLOW_NO_AUTH=false
BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
EVENT_SECRET=replace-with-another-32-random-characters
PORT=8787
DATA_FILE=./data/pocket.sqlite
HUAWEI_SERVICE_ACCOUNT=
HUAWEI_CATEGORY=MARKETING
HUAWEI_TEST_MESSAGE=true
